SITE_URL=https://techidea.online
# Keep false until the site is ready for public indexing.
SITE_INDEXABLE=false

# Public APIs: production defaults to disabled. Never use local mode in production.
# Local mode has ONE in-process development bucket, not a production guarantee.
API_RATE_LIMIT_MODE=disabled
# Set to nginx only after proxy configuration; generate a private random 32-byte hex
# secret and set the SAME value in Next.js and the rendered Nginx config.
API_PROXY_SECRET=
API_CORS_ORIGINS=*
API_MAX_RESPONSE_BYTES=262144
API_LOCAL_RATE_LIMIT=60
# Used by deploy/render-nginx.mjs (Nginx shared-memory limits):
API_RATE_PER_MINUTE=60
API_RATE_BURST=20
API_GLOBAL_RATE_PER_SECOND=50

# Documentation snippets only; browser playground always uses same-origin paths.
API_PUBLIC_BASE_URL=https://techidea.online

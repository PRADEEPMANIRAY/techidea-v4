# Include inside the existing HTTPS server {}. The Next process must bind to
# 127.0.0.1:3000; firewall all direct backend access. Do not enable proxy caching.
location ^~ /api/v1/ {
    limit_req zone=techidea_api_per_ip burst=__BURST__ nodelay;
    limit_req zone=techidea_api_total burst=100 nodelay;
    limit_req_status 429;
    limit_conn techidea_api_connections 10;
    limit_conn_status 429;
    client_max_body_size 1k;
    client_body_timeout 10s;
    error_page 429 = @techidea_api_rate_limited;
    error_page 413 = @techidea_api_body_rejected;
    error_page 502 503 504 = @techidea_api_unavailable;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-TechIdea-Proxy-Token "__SECRET__";
    # Overwrite client forwarding headers; the app does not trust them for limits.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;
    proxy_buffering on;
    proxy_cache off;
    access_log off;
}
# ODbL redistribution files use the same IP/global budget, so bulk downloads
# cannot bypass the API's request admission limits.
location ^~ /datasets/v1/ {
    limit_req zone=techidea_api_per_ip burst=__BURST__ nodelay;
    limit_req zone=techidea_api_total burst=100 nodelay;
    limit_req_status 429;
    limit_conn techidea_api_connections 10;
    limit_conn_status 429;
    error_page 429 = @techidea_api_rate_limited;
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_cache off;
    access_log off;
}
location @techidea_api_rate_limited {
    default_type application/json;
    add_header Retry-After 60 always;
    add_header Cache-Control "no-store" always;
    add_header Access-Control-Allow-Origin $techidea_api_cors always;
    add_header Vary Origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    return 429 '{"success":false,"error":{"code":"RATE_LIMITED","message":"Too many requests. Try again later."}}';
}
location @techidea_api_body_rejected {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Access-Control-Allow-Origin $techidea_api_cors always;
    add_header Vary Origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    return 413 '{"success":false,"error":{"code":"BODY_NOT_ALLOWED","message":"Request bodies are not supported."}}';
}
location @techidea_api_unavailable {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Access-Control-Allow-Origin $techidea_api_cors always;
    add_header Vary Origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    return 503 '{"success":false,"error":{"code":"SERVICE_UNAVAILABLE","message":"API service is temporarily unavailable."}}';
}
